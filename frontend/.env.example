# Copier en .env.local (développement) ou saisir dans Vercel > Settings > Environment Variables.
# SANS préfixe NEXT_PUBLIC_ : l'adresse du backend reste côté serveur (BFF /api/v1 et proxy).

# Adresse de l'API AgriRot, avec /api/v1.
# Laisser vide = MODE DÉMO : le site affiche les données de démonstration, sans compte ni backend.
AGROROT_API_URL=
# Exemples :
# AGROROT_API_URL=http://localhost:8000/api/v1
# AGROROT_API_URL=https://api.agrirot.example/api/v1

# Durée de vie du cookie de renouvellement, en jours (= REFRESH_TOKEN_DAYS du backend). Facultatif.
# AGROROT_REFRESH_DAYS=7

# Délai maximal d'attente du backend, en millisecondes (défaut 45000 ; le calcul des stratégies a 120 s).
# Au-delà, l'écran affiche « Le serveur met trop de temps à répondre » au lieu de rester bloqué. Facultatif.
# AGROROT_API_TIMEOUT_MS=45000

# Recherche de lieu sur la carte : Nominatim (OpenStreetMap) par défaut, sans clé. Facultatif.
# Pour un usage intensif, pointer vers une autre instance compatible (adresse publique, donc préfixe NEXT_PUBLIC_).
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
