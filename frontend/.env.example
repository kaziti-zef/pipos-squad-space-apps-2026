# Copier en .env.local (développement) ou saisir dans Vercel > Settings > Environment Variables.
# SANS préfixe NEXT_PUBLIC_ : l'adresse du backend reste côté serveur (BFF /api/v1 et proxy).

# Adresse de l'API AgriRot, avec /api/v1.
# Laisser vide = MODE DÉMO : le site affiche les données de démonstration, sans compte ni backend.
AGROROT_API_URL=
# Exemples :
# AGROROT_API_URL=http://localhost:8000/api/v1
# AGROROT_API_URL=https://api.agrirot.example/api/v1

# Durée de vie du cookie de renouvellement, en jours (= REFRESH_TOKEN_DAYS du backend). Facultatif.
# AGROROT_REFRESH_DAYS=7
